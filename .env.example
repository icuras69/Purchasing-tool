DEBUG=false
DATABASE_AUTO_CREATE_TABLES=false

# OrderPro read-only API discovery.
# Required token permissions for this phase:
# products:read, inventory:read, suppliers:read, purchase-orders:read, warehouses:read.
# orders:read is optional for discovering order payloads.
ORDERPRO_API_BASE_URL=https://wms.orderpro.cloud/api/v2
ORDERPRO_API_TOKEN=
ORDERPRO_SYNC_ENABLED=false
ORDERPRO_TIMEOUT_SECONDS=30
