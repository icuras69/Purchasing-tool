DEBUG=false
DATABASE_URL=
DATABASE_AUTO_CREATE_TABLES=false
FRONTEND_ORIGIN=http://localhost:5173
CORS_ORIGINS=

# Single-admin authentication. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OrderPro read-only API discovery.
# Required token permissions for this phase:
# products:read, inventory:read, suppliers:read, purchase-orders:read, warehouses:read.
# orders:read is optional for discovering order payloads.
ORDERPRO_API_BASE_URL=https://wms.orderpro.cloud/api/v2
ORDERPRO_API_TOKEN=
ORDERPRO_SYNC_ENABLED=false
ORDERPRO_TIMEOUT_SECONDS=30

# LLM provider. Keep mock/disabled for staging until a separate task enables real LLM calls.
LLM_PROVIDER=mock
ENABLE_REAL_LLM=false
OPENAI_API_KEY=
OPENAI_MODEL=
